    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.14.0" />
    <!-- Share authentication and process containment, not the full application's dependency graph. -->
    <Compile Include="../../src/AgentSmith.OpenAI/ChatGptAuth.cs" Link="Shared/ChatGptAuth.cs" />
