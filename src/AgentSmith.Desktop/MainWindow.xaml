<Window x:Class="AgentSmith.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentSmith · Call Recorder" Width="1280" Height="900" MinWidth="1000" MinHeight="720" Background="#F4F6FA" FontFamily="Segoe UI" FontSize="14" Closing="OnClosing">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20"><TextBlock Text="AgentSmith" FontSize="26" FontWeight="SemiBold"/><TextBlock Text=" / Call Recorder" FontSize="26" Foreground="#677487"/><TextBlock Text="LOCAL TRANSCRIPTION" Foreground="#38685A" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="8" Padding="14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top"><TextBlock Text="Recordings" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/><Button Content="Refresh recordings and devices" Click="RefreshClick" Margin="0,0,0,10"/></StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button x:Name="DeleteRecordingButton" Content="Delete selected recording…" Click="DeleteRecordingClick" Margin="0,0,0,8"/><Button x:Name="DeleteAnalysisButton" Content="Delete selected analysis…" Click="DeleteAnalysisClick" Margin="0"/></StackPanel>
          <ListBox x:Name="LibraryList" BorderThickness="0" SelectionChanged="LibraryChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,9"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#677487" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" CornerRadius="8" Padding="18">
          <StackPanel>
            <TextBox x:Name="TitleInput" Text="New call" AutomationProperties.Name="Recording title" Margin="0,0,0,10"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Call audio · headphones / speakers" Margin="0,0,0,5"/><ComboBox x:Name="OutputDevice" DisplayMemberPath="Name" AutomationProperties.Name="Call audio device"/><ProgressBar x:Name="CallLevel" Maximum="1" Height="6" Margin="0,8,0,0"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="My microphone" Margin="0,0,0,5"/><ComboBox x:Name="MicrophoneDevice" DisplayMemberPath="Name" AutomationProperties.Name="Microphone device"/><ProgressBar x:Name="MicLevel" Maximum="1" Height="6" Margin="0,8,0,0"/></StackPanel>
            </Grid>
            <WrapPanel Margin="0,14,0,10">
              <Button x:Name="RecordButton" Content="● Record" Background="#DDEFE8" Click="RecordClick"/>
              <Button x:Name="StopButton" Content="■ Stop" Click="StopClick" IsEnabled="False"/>
              <Button x:Name="TestButton" Content="Test · 10 seconds" Click="TestClick"/>
              <CheckBox x:Name="MuteInput" Content="Mute recorder microphone" VerticalAlignment="Center" Click="MuteClick" IsEnabled="False"/>
              <TextBlock x:Name="Elapsed" Text="00:00:00" VerticalAlignment="Center" Margin="18,0,0,0" FontFamily="Consolas" FontSize="18"/>
            </WrapPanel>
            <TextBlock Text="Call audio includes other apps on that output. Recorder mute is independent of Teams / VM mute. Headset recommended." FontSize="12" Foreground="#677487" TextWrapping="Wrap"/>
            <Expander Header="Language and processing limits" Margin="0,10,0,0"><StackPanel Margin="0,8,0,0">
              <WrapPanel><TextBlock Text="Transcription" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="LanguageInput" Width="170" DisplayMemberPath="Name" SelectedValuePath="Code"/>
                <TextBlock Text="Other language code" VerticalAlignment="Center" Margin="12,0,8,0"/><TextBox x:Name="OtherLanguage" Width="65" ToolTip="Optional Whisper language code, such as de or it; overrides the language menu."/></WrapPanel>
              <WrapPanel Margin="0,8,0,0"><TextBlock Text="Storage GiB" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="StorageInput" Width="65"/>
                <TextBlock Text="Minutes per attempt" VerticalAlignment="Center" Margin="12,0,6,0"/><TextBox x:Name="MinutesInput" Width="65"/>
                <TextBlock Text="Summary request limit" VerticalAlignment="Center" Margin="12,0,6,0"/><TextBox x:Name="RequestsInput" Width="65"/></WrapPanel>
            </StackPanel></Expander>
          </StackPanel>
        </Border>
        <WrapPanel Grid.Row="1" Margin="0,14,0,12">
          <Button x:Name="TranscribeButton" Content="Transcribe / Resume" Click="TranscribeClick"/>
          <Button x:Name="PauseButton" Content="Pause processing" Click="PauseClick" IsEnabled="False"/>
          <Button x:Name="KeepButton" Content="Keep test" Click="KeepClick" Visibility="Collapsed"/>
          <Button x:Name="ExportButton" Content="Export results…" Click="ExportClick"/>
          <Button x:Name="RawExportButton" Content="Export audio…" Click="RawExportClick"/>
          <CheckBox x:Name="RetryFailed" Content="Retry failed" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <CheckBox x:Name="RetryUncertain" Content="Retry uncertain" VerticalAlignment="Center"/>
        </WrapPanel>
        <TabControl Grid.Row="2" Background="White" BorderBrush="#DCE2EA">
          <TabItem Header="Transcript"><DockPanel Margin="12">
            <TextBox x:Name="SearchInput" DockPanel.Dock="Top" AutomationProperties.Name="Search transcript" ToolTip="Search transcript" TextChanged="SearchChanged" Margin="0,0,0,10"/>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><TextBlock Text="Rename selected speaker" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="SpeakerName" Width="150"/><Button Content="Save name" Click="RenameClick" Margin="8,0,0,0"/></WrapPanel>
            <ListBox x:Name="TranscriptList" BorderThickness="0" MouseDoubleClick="TranscriptDoubleClick" KeyDown="TranscriptKeyDown" SelectionChanged="TranscriptSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="125"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="#356A86"/><TextBlock Grid.Column="1" Text="{Binding Speaker}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </DockPanel></TabItem>
          <TabItem Header="Summary"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="ModelLabel" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="Generate summary sends transcript evidence to this provider. Audio stays local." Foreground="#677487" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,10"><Button x:Name="SummaryButton" Content="Generate summary" Click="SummaryClick"/><ComboBox x:Name="SummaryLanguage" Width="150" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="SummaryLanguageChanged"/></WrapPanel>
          </StackPanel><FlowDocumentScrollViewer x:Name="SummaryView" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"/></DockPanel></TabItem>
          <TabItem Header="Coverage"><TextBox x:Name="CoverageText" Margin="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></TabItem>
        </TabControl>
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="12" Margin="0,12,0,0"><DockPanel>
          <Button x:Name="PlayButton" Content="Play / Pause" Click="PlayClick" DockPanel.Dock="Left"/>
          <ComboBox x:Name="PlaybackTrack" Width="125" SelectedIndex="0" SelectionChanged="PlaybackTrackChanged" DockPanel.Dock="Right"><ComboBoxItem Content="Both tracks"/><ComboBoxItem Content="Call only"/><ComboBoxItem Content="Microphone"/></ComboBox>
          <Slider x:Name="PlaybackPosition" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="8,0,14,0" ValueChanged="PlaybackSeek" AutomationProperties.Name="Playback position"/>
        </DockPanel></Border>
      </Grid>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="2" Text="Loading…" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#405369"/>
  </Grid>
</Window>
