<Application ThemeMode="System" x:Class="AgentSmith.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- Keep Microsoft's control templates, focus cues and theme resources. -->
      <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="36"/></Style>
      <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}"><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
      <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
      <Style TargetType="TabItem" BasedOn="{StaticResource DefaultTabItemStyle}"><Setter Property="Padding" Value="18,12"/></Style>
      <Style TargetType="TabControl" BasedOn="{StaticResource DefaultTabControlStyle}"/>
      <Style TargetType="ListBox" BasedOn="{StaticResource DefaultListBoxStyle}"><Setter Property="Background" Value="Transparent"/></Style>
      <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
      <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
