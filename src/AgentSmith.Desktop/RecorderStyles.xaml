<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Recorder.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Recorder.Border}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Recorder.Muted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="{DynamicResource Recorder.FontCaption}"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource Recorder.FontHeading}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="CommandButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="FontSize" Value="{DynamicResource Recorder.FontBody}"/><Setter Property="Foreground" Value="{DynamicResource Recorder.Text}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="MinWidth" Value="62"/><Setter Property="Padding" Value="8,7"/><Setter Property="Margin" Value="2"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
        <StackPanel><TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{TemplateBinding Foreground}" FontSize="{DynamicResource Recorder.FontIcon}" HorizontalAlignment="Center" Margin="0,0,0,7"/>
          <ContentPresenter HorizontalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{DynamicResource Recorder.Text}"/></StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Recorder.Hover}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Recorder.Accent}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Recorder.Selection}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NavigationButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Recorder.Text}"/>
    <Setter Property="Height" Value="34"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="16,8"/><Setter Property="FontSize" Value="{DynamicResource Recorder.FontNavigation}"/><Setter Property="Margin" Value="4,0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Chrome" CornerRadius="8,8,0,0" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"><Grid>
        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
        <Border x:Name="Line" Height="3" Background="Transparent" VerticalAlignment="Bottom" Margin="12,0" CornerRadius="2"/>
      </Grid></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Recorder.Accent}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Recorder.Surface}"/><Setter TargetName="Line" Property="Background" Value="{DynamicResource Recorder.Icon}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Recorder.Hover}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Recorder.Accent}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WorkspaceTab" TargetType="TabItem">
    <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource Recorder.Text}"/>
    <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="FontSize" Value="{DynamicResource Recorder.FontBody}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <Border x:Name="Chrome" Background="{DynamicResource Recorder.Surface}" BorderBrush="{DynamicResource Recorder.Border}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Recorder.Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <ContentPresenter x:Name="Header" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Recorder.Text}"/>
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Recorder.Hover}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Recorder.Selection}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Recorder.Icon}"/><Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource Recorder.Accent}"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Recorder.Accent}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Recorder.Accent}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SeekTrackButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
      <Grid Background="Transparent"><Border Height="5" VerticalAlignment="Center" CornerRadius="2.5" Background="{TemplateBinding Background}"/></Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SeekSlider" TargetType="Slider">
    <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Height" Value="28"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="SmallChange" Value="0.1"/><Setter Property="LargeChange" Value="10"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid Background="Transparent">
        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SeekTrackButton}" Command="Slider.DecreaseLarge" Background="{DynamicResource Recorder.Icon}"/></Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SeekTrackButton}" Command="Slider.IncreaseLarge" Background="{DynamicResource Recorder.SeekTrack}"/></Track.IncreaseRepeatButton>
          <Track.Thumb><Thumb x:Name="SeekThumb" Width="18" Height="28" Cursor="Hand">
            <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent">
              <Ellipse Width="14" Height="14" Fill="{DynamicResource Recorder.Icon}" Stroke="{DynamicResource Recorder.Surface}" StrokeThickness="2"/>
              <Ellipse x:Name="Ring" Width="18" Height="18" Stroke="{DynamicResource Recorder.Accent}" StrokeThickness="1" Visibility="Collapsed"/>
            </Grid><ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Thumb.Template>
          </Thumb></Track.Thumb>
        </Track>
        <Border x:Name="FocusRing" BorderThickness="1" BorderBrush="Transparent" CornerRadius="5" IsHitTestVisible="False"/>
      </Grid><ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Recorder.Accent}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="{DynamicResource Recorder.Accent}"/><Setter Property="Background" Value="{DynamicResource Recorder.Surface}"/>
  </Style>
  <Style x:Key="RecordingRow" TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="10,8"/>
    <Setter Property="Foreground" Value="{DynamicResource Recorder.Text}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Chrome" CornerRadius="7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
        <Grid><Border x:Name="Line" Width="3" HorizontalAlignment="Left" CornerRadius="2"/><ContentPresenter Margin="{TemplateBinding Padding}"/></Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Recorder.Hover}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Recorder.Selection}"/><Setter TargetName="Line" Property="Background" Value="{DynamicResource Recorder.Icon}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Recorder.Accent}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TranscriptRow" TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,3,4,3"/>
    <Setter Property="Foreground" Value="{DynamicResource Recorder.Text}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Row" Background="{DynamicResource Recorder.Surface}" BorderBrush="{DynamicResource Recorder.Border}" BorderThickness="1" CornerRadius="7" Padding="10,8"><ContentPresenter/></Border>
      <ControlTemplate.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Recorder.Selection}"/></DataTrigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Recorder.Hover}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Recorder.Icon}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Recorder.Accent}"/><Setter TargetName="Row" Property="BorderThickness" Value="2"/><Setter TargetName="Row" Property="Padding" Value="9,7"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FollowToggle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Recorder.Text}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Border x:Name="Focus" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4" Padding="3"><StackPanel Orientation="Horizontal">
        <Border Width="16" Height="16" Background="{DynamicResource Recorder.Surface}" BorderBrush="{DynamicResource Recorder.Border}" BorderThickness="1" CornerRadius="3"><TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{DynamicResource Recorder.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/></Border>
        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
      </StackPanel></Border>
      <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource Recorder.Accent}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
